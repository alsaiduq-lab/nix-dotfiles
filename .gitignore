# This gitignore is a whitelist. Inspired by https://rgbcu.be/blog/gitignore

*
!.gitignore
!flake.lock
!flake.nix
!.sops.yaml
!README.md

!config/
!config/**/
!config/**/*.json
!config/scripts/*.sh

!lib/
!lib/**/
!lib/**/*.nix

!home-manager/
!home-manager/**/
!home-manager/**/*.nix

!hosts/
!hosts/**/
!hosts/**/*.nix

!pkgs/
!pkgs/*.nix
!pkgs/**/
!pkgs/**/default.nix
!pkgs/**/deps.json
!pkgs/**/*.sh
!pkgs/patches/*.patch

!secrets/
!secrets/secrets.yaml
